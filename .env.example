# NetworkOps AI

# FastAPI backend
API_HOST=127.0.0.1
API_PORT=8000

# Google Cloud
GOOGLE_CLOUD_PROJECT=networkops-ai-venkat
GOOGLE_CLOUD_LOCATION=global

# Vertex AI
VERTEX_MODEL=gemini-2.5-flash

# BigQuery
BIGQUERY_DATASET=networkops
BIGQUERY_TABLE=telemetry

# Workspace integrations are optional.
# Never place OAuth tokens or client secrets in this file.
